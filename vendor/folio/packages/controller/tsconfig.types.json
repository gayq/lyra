{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationDir": "./dist/types",
		"removeComments": false,
		"noEmitOnError": true,
		"noEmit": false,
		"strict": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false
	},
	"include": ["src"]
}
