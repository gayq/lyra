{
	"name": "@mercuryworkshop/folio",
	"version": "2.0.67-alpha.2",
	"license": "AGPL-3.0-only",
	"description": "An experimental web proxy that aims to be the successor to Ultraviolet",
	"type": "module",
	"main": "./dist/folio-external.mjs",
	"module": "./dist/folio-external.mjs",
	"types": "./dist/types/typesEntry.d.ts",
	"scripts": {
		"build": "cd ../.. && rspack build --mode production",
		"rewriter:build": "cd rewriter/wasm/ && bash build.sh && cd ../../"
	},
	"exports": {
		".": {
			"types": "./dist/types/typesEntry.d.ts",
			"default": "./dist/folio-external.mjs"
		},
		"./route": {
			"types": "./dist/types/shared/route.d.ts",
			"default": "./src/shared/route.ts"
		},
		"./bundled": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/folio.mjs"
		},
		"./path": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.cjs"
		}
	},
	"files": [
		"dist",
		"lib",
		"src/shared/route.ts"
	],
	"keywords": [],
	"author": "",
	"dependencies": {
		"@mercuryworkshop/proxy-transports": "catalog:",
		"@noble/ciphers": "2.4.0",
		"dom-serializer": "^2.0.0",
		"domhandler": "^5.0.3",
		"domutils": "^3.2.2",
		"htmlparser2": "catalog:",
		"idb": "^8.0.3",
		"parse-domain": "^8.2.2"
	}
}
