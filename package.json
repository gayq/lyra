{
  "name": "waves",
  "version": "3.6.1",
  "description": "a really cool web-proxy",
  "type": "module",
  "packageManager": "bun@1.2.17",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "cross-env UV_THREADPOOL_SIZE=32 NODE_ENV=production bun index.mjs",
    "dev": "cross-env UV_THREADPOOL_SIZE=32 NODE_ENV=development bun index.mjs",
    "lint": "eslint .",
    "build": "vite build --config vite.config.js",
    "build:legacy": "bun build.mjs",
    "postinstall": "bun others/patch.js"
  },
  "dependencies": {
    "@mercuryworkshop/bare-mux": "latest",
    "@mercuryworkshop/epoxy-transport": "latest",
    "@mercuryworkshop/libcurl-transport": "latest",
    "@preact/preset-vite": "^2.10.5",
    "@preact/signals": "^2.9.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^5.0.0-beta.3",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "lru-cache": "^11.1.0",
    "preact": "^10.29.1",
    "vite": "^8.0.8",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^9.5.0",
    "javascript-obfuscator": "^5.0.1",
    "prettier": "^3.8.2",
    "terser": "^5.46.1"
  }
}